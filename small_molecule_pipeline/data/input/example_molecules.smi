# Example small-molecule input (one SMILES per line)
# Imatinib
Cc1ccc(NC(=O)c2ccc(CN3CCN(C)CC3)cc2)cc1Nc1nccc(-c2cccnc2)n1
# Venetoclax
Cc1ccc(-n2cc(C(=O)Nc3ccc(N4CCN(CC(F)(F)F)CC4)c(C(F)(F)F)c3)nn2)cc1Oc1cccc(Cl)c1
# Erlotinib
C#Cc1cccc(Nc2ncnc3cc(OCCO)c(OCCO)cc23)c1
# Aspirin (simple, known drug)
CC(=O)Oc1ccccc1C(=O)O
# Rhodamine B (PAINS example)
CCN(CC)c1ccc2c(-c3ccccc3C(=O)O)c3ccc(=[N+](CC)CC)cc3oc2c1
