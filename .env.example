# Copy to `.env` and fill in your token. `.env` is gitignored — never commit it.
#   cp .env.example .env
#
# Get a token at https://huggingface.co/settings/tokens (a read token is enough),
# and accept the model license at https://huggingface.co/facebook/UMA first.
# No quotes around the value.
HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional: where to cache downloaded model weights.
# HF_HOME=./.cache/huggingface

# NOTE (Claude Code cloud): a local .env is for terminal / --teleport use.
# On claude.ai/code the token must ALSO be set as an environment variable in the
# environment settings, and huggingface.co added to the network allowlist —
# see the "在 Claude Code cloud 上运行" section in README.md.
