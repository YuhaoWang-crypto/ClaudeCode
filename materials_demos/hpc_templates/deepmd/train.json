{
  "_comment": "DeePMD-kit training config for a molten salt. Set type_map to YOUR elements. Point systems at the deepmd/npy dirs produced from AIMD (one per temperature point).",
  "model": {
    "type_map": ["Li", "Na", "K", "F"],
    "descriptor": {
      "type": "se_e2_a",
      "sel": "auto",
      "rcut_smth": 0.5,
      "rcut": 6.0,
      "neuron": [25, 50, 100],
      "resnet_dt": false,
      "axis_neuron": 16,
      "seed": 1
    },
    "fitting_net": {
      "neuron": [240, 240, 240],
      "resnet_dt": true,
      "seed": 1
    }
  },
  "learning_rate": {
    "type": "exp",
    "start_lr": 0.001,
    "stop_lr": 3.5e-08,
    "decay_steps": 5000
  },
  "loss": {
    "type": "ener",
    "start_pref_e": 0.02,
    "limit_pref_e": 1,
    "start_pref_f": 1000,
    "limit_pref_f": 1,
    "start_pref_v": 0,
    "limit_pref_v": 0
  },
  "training": {
    "training_data": {
      "systems": [
        "../deepmd_dataset/T300K",
        "../deepmd_dataset/T500K",
        "../deepmd_dataset/T700K",
        "../deepmd_dataset/T900K",
        "../deepmd_dataset/T1100K",
        "../deepmd_dataset/T1300K"
      ],
      "batch_size": "auto"
    },
    "validation_data": {
      "systems": ["../deepmd_dataset/T700K"],
      "batch_size": "auto"
    },
    "numb_steps": 1000000,
    "seed": 10,
    "disp_file": "lcurve.out",
    "disp_freq": 1000,
    "save_freq": 10000
  }
}
